# Required
TARTIB_PASSWORD=change-me

# Optional. Cookie signing key; derived from the password when unset.
# TARTIB_SECRET=

# IANA timezone that defines "today". Default UTC.
TARTIB_TZ=UTC

# Required. The only spaces that exist. The classifier files into these or asks you.
TARTIB_SPACES=work,home,health,finance,ideas,travel

# Classifier: the Codex CLI, run non-interactively. Needs `codex login` done on the host;
# compose mounts ~/.codex into the container. Set to "off" to disable classification.
# TARTIB_AI_COMMAND=codex
# TARTIB_AI_MODEL=            # passed as `codex --model`; unset uses Codex's default
# TARTIB_AI_TIMEOUT=120       # seconds per classification

# Proposals at or above this confidence are filed without asking. Default 0.85.
# TARTIB_AUTOFILE_CONFIDENCE=0.85

# Every pomodoro is this long. There is no per-session choice: a length you pick each time is
# a decision the timer exists to save you. Default 25, minimum 1.
# TARTIB_SESSION_MINUTES=25

# Push reminders. Without both VAPID keys the reminder loop does not run at all.
# Generate a pair once, on the host, and paste the three lines it prints:
#   cd backend && uv run python -m tartib.vapid
# Web Push needs HTTPS: it will not work from a phone over http://localhost.
# TARTIB_VAPID_PUBLIC=
# TARTIB_VAPID_PRIVATE=
# TARTIB_VAPID_EMAIL=mailto:you@example.com   # a contact the push service can reach
# TARTIB_SUMMARY_TIME=08:00                   # one daily digest, in TARTIB_TZ

# Where the SQLite file lives. The compose volume is mounted at /data, so the default is right
# inside Docker; set it when running the backend directly on the host.
# TARTIB_DB_PATH=/data/tartib.db

# Where the built frontend is served from. The image sets this itself; you only need it when
# running uvicorn by hand against `frontend/dist`.
# TARTIB_STATIC_DIR=
